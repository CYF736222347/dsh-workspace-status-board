{
  "name": "@local/dsh-workspace-status-board",
  "version": "1.0.0",
  "description": "Status-first workspace board for the DSH sidebar: sorts workspaces and their tasks by needs-input, running, then done, with search, same-status drag ordering, task archive/restore, and three distinct status markers.",
  "type": "module",
  "license": "MIT",
  "author": "CYF736222347",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "sidebar",
    "status",
    "archive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CYF736222347/dsh-workspace-status-board.git"
  },
  "homepage": "https://github.com/CYF736222347/dsh-workspace-status-board#readme",
  "bugs": {
    "url": "https://github.com/CYF736222347/dsh-workspace-status-board/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
